  private toggleFullscreen(): void {
    this.isFullscreen = !this.isFullscreen;
    this.element.classList.toggle('oe-webcam-fullscreen', this.isFullscreen);
    document.body.classList.toggle('oe-webcam-fullscreen-active', this.isFullscreen);
