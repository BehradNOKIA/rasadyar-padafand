function normalizeCityQuery(value: string): string {
  return value
    .replace(/\u064A/g, '\u06CC')
    .replace(/\u0643/g, '\u06A9')
    .replace(/\u200C/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function containsPersianScript(value: string): boolean {
  return /[\u0600-\u06FF]/.test(value);
}

function isBlockedProviderRecord(record: unknown): boolean {
  let serialized = '';
  try {
    serialized = JSON.stringify(record).toLowerCase();
  } catch {
    return false;
  }
  return BLOCKED_PROVIDER_MARKERS.some(marker => serialized.includes(marker));
}

function formatDistance(value: number | null): string {
  if (value == null || !Number.isFinite(value)) return '';
  if (value < 1) return `${Math.max(1, Math.round(value * 1000))} متر`;
  return `${value < 10 ? value.toFixed(1) : Math.round(value)} کیلومتر`;
}

function formatFrameAge(seconds: number | null): string {
  if (seconds == null || !Number.isFinite(seconds) || seconds < 0) return '';
  if (seconds < 60) return `${Math.max(1, Math.round(seconds))} ثانیه پیش`;
  if (seconds < 3600) return `${Math.round(seconds / 60)} دقیقه پیش`;
  if (seconds < 86400) return `${Math.round(seconds / 3600)} ساعت پیش`;
  return `${Math.round(seconds / 86400)} روز پیش`;
}

function extractRows(payload: unknown): OpenEyeCameraRecord[] {
  if (Array.isArray(payload)) return payload as OpenEyeCameraRecord[];
  if (!payload || typeof payload !== 'object') return [];

  const objectPayload = payload as {
    items?: unknown;
    cameras?: unknown;
    results?: unknown;
    webcams?: unknown;
  };

  const candidates = [
    objectPayload.items,
    objectPayload.cameras,
    objectPayload.results,
    objectPayload.webcams,
  ];

  for (const candidate of candidates) {
    if (Array.isArray(candidate)) return candidate as OpenEyeCameraRecord[];
  }

  return [];
}

function mapCameraRecord(record: OpenEyeCameraRecord): CameraResult | null {
  const id = record.id?.trim();
  if (!id || isBlockedProviderRecord(record)) return null;

  const viewUrl = record.view?.url?.trim() || null;
  const previewUrl =
    record.view?.render === 'image'
      ? (viewUrl || record.preview_url?.trim() || null)
      : (record.preview_url?.trim() || null);

  const attribution = record.redistribution?.attribution ?? null;
  const sourceUrl =
    record.view?.render === 'link'
      ? viewUrl
      : (record.source_url?.trim() || attribution?.url?.trim() || null);

  return {
    id,
    handle: record.handle?.trim() || null,
    title: record.title?.trim() || 'وب‌کم عمومی',
    category: record.category?.trim() || 'webcam',
    latitude: typeof record.lat === 'number' ? record.lat : null,
    longitude: typeof record.lon === 'number' ? record.lon : null,
    live: record.live === true,
    previewUrl,
    sourceUrl,
    sourceName: attribution?.name?.trim() || null,
    distanceKm: typeof record.distance_km === 'number' ? record.distance_km : null,
    lastFrameAgeSeconds: typeof record.last_frame_age_s === 'number' ? record.last_frame_age_s : null,
    frameIntervalSeconds: typeof record.frame_interval_s === 'number' ? record.frame_interval_s : null,
    youtubeVideoId: null,
  };
}

function uniqueCameras(cameras: CameraResult[]): CameraResult[] {
  const seen = new Set<string>();
  const output: CameraResult[] = [];
  for (const camera of cameras) {
    if (seen.has(camera.id)) continue;
    seen.add(camera.id);
    output.push(camera);
  }
  return output;
}

