  private async requestJson(url: string, signal: AbortSignal): Promise<unknown> {
    const response = await fetch(url, {
      signal,
      headers: { Accept: 'application/json' },
      cache: 'no-store',
    });
    if (!response.ok) throw new Error(`HTTP ${response.status}`);
    return response.json() as Promise<unknown>;
  }

  private async geocodeCity(query: string, signal: AbortSignal): Promise<SearchLocation | null> {
    const params = new URLSearchParams({
      name: query,
      count: '5',
      language: containsPersianScript(query) ? 'fa' : 'en',
      format: 'json',
    });

    const payload = await this.requestJson(`${OPEN_METEO_GEOCODING_URL}?${params.toString()}`, signal) as {
      results?: Array<{
        name?: string;
        country?: string;
        latitude?: number;
        longitude?: number;
        population?: number;
      }>;
    };

    const candidates = (payload.results ?? [])
      .filter(item =>
        typeof item.name === 'string' &&
        typeof item.latitude === 'number' &&
        typeof item.longitude === 'number'
      )
      .sort((a, b) => (b.population ?? 0) - (a.population ?? 0));

    const best = candidates[0];
    if (!best || typeof best.latitude !== 'number' || typeof best.longitude !== 'number') return null;

    return {
      name: best.name ?? query,
      country: best.country ?? '',
      latitude: best.latitude,
      longitude: best.longitude,
    };
  }

  private async fetchCamerasNear(
    latitude: number,
    longitude: number,
    radiusKm: number,
    limit: number,
    signal: AbortSignal,
  ): Promise<CameraResult[]> {
    const params = new URLSearchParams({
      near: `${latitude},${longitude}`,
      radius_km: String(radiusKm),
      embeddable: '1',
      limit: String(limit),
    });

    const payload = await this.requestJson(`${OPENEYE_CATALOG_URL}?${params.toString()}`, signal);
    const rows = extractRows(payload);

    return uniqueCameras(
      rows
        .map(mapCameraRecord)
        .filter((camera): camera is CameraResult => camera !== null)
        .sort((a, b) => {
          const aVisual = a.previewUrl ? 1 : 0;
          const bVisual = b.previewUrl ? 1 : 0;
          if (aVisual !== bVisual) return bVisual - aVisual;
          const aAge = a.lastFrameAgeSeconds ?? Number.POSITIVE_INFINITY;
          const bAge = b.lastFrameAgeSeconds ?? Number.POSITIVE_INFINITY;
          return aAge - bAge;
        })
    );
  }

  private async fetchCamerasByQuery(query: string, limit: number, signal: AbortSignal): Promise<CameraResult[]> {
    const params = new URLSearchParams({ q: query, embeddable: '1', limit: String(limit) });
    const payload = await this.requestJson(`${OPENEYE_CATALOG_URL}?${params.toString()}`, signal);
    return uniqueCameras(
      extractRows(payload)
        .map(mapCameraRecord)
        .filter((camera): camera is CameraResult => camera !== null)
    );
  }

  private async fetchFeatured(signal: AbortSignal): Promise<CameraResult[]> {
    const payload = await this.requestJson(OPENEYE_FEATURED_URL, signal);
    return uniqueCameras(
      extractRows(payload)
        .map(mapCameraRecord)
        .filter((camera): camera is CameraResult => camera !== null)
    );
  }

  private async fetchRegionCameras(region: RegionFilter, signal: AbortSignal): Promise<CameraResult[]> {
    const preset = REGION_PRESETS[region];

    if (preset.query) {
      const queried = await this.fetchCamerasByQuery(preset.query, 12, signal);
      return queried.slice(0, GRID_LIMIT);
    }

    if (!preset.anchors?.length) {
      const featured = await this.fetchFeatured(signal);
      return featured.slice(0, GRID_LIMIT);
    }

    const batches = await Promise.all(
      preset.anchors.map(anchor =>
        this.fetchCamerasNear(anchor.latitude, anchor.longitude, SEARCH_FALLBACK_RADIUS_KM, 5, signal)
          .then(items => items[0] ? [items[0]] : [])
      )
    );

    let cameras = uniqueCameras(batches.flat());
    if (cameras.length < GRID_LIMIT && region === 'all') {
      try {
        const featured = await this.fetchFeatured(signal);
        cameras = uniqueCameras([...cameras, ...featured]);
      } catch {
        // Regional results are still usable if featured fallback fails.
      }
    }

    return cameras.slice(0, GRID_LIMIT);
  }

  private async loadRegion(region: RegionFilter, silent = false): Promise<void> {
    if (this.destroyed) return;
    this.abortController?.abort();
    const controller = new AbortController();
    this.abortController = controller;

    this.regionFilter = region;
    this.searchMode = false;
    this.currentLocation = null;
    this.currentContextLabel = REGION_PRESETS[region].label;
    if (this.searchInput && !silent) this.searchInput.value = '';
    this.updateRegionButtons();

    if (this.sourceMode === 'youtube') {
      const cameras = this.getYoutubeRegionCameras(region);
      this.cameras = cameras;
      this.selectedCameraId = cameras[0]?.id ?? null;
      if (!silent) {
        this.setStatus(
          cameras.length
            ? `${cameras.length} پخش منتخب YouTube آماده است • این حالت اختیاری است و ممکن است در برخی شبکه‌ها فیلتر باشد.`
            : 'برای این ناحیه پخش YouTube از پیش ثبت‌شده‌ای نداریم.',
          cameras.length ? 'warning' : 'error',
        );
      }
      this.render();
      if (!silent) this.setBusy(false);
      if (this.abortController === controller) this.abortController = null;
      return;
    }

    if (!silent) {
      this.setBusy(true);
      this.setStatus(`در حال دریافت وب‌کم‌های ${REGION_PRESETS[region].label} از منبع غیر یوتیوب…`, 'loading');
      this.renderLoading('در حال دریافت وب‌کم‌های عمومی…');
    }

    try {
      const cameras = await this.fetchRegionCameras(region, controller.signal);
      if (controller.signal.aborted || this.destroyed) return;
      this.cameras = cameras;
      if (!this.selectedCameraId || !cameras.some(camera => camera.id === this.selectedCameraId)) {
        this.selectedCameraId = cameras[0]?.id ?? null;
      }

      if (!silent) {
        this.setStatus(
          cameras.length
            ? `${cameras.length} وب‌کم قابل‌نمایش دریافت شد • OpenEye • بدون اتصال مستقیم به YouTube`
            : 'در این ناحیه وب‌کم غیر یوتیوب قابل‌نمایشی پیدا نشد.',
          cameras.length ? 'success' : 'warning',
        );
      }
      this.render();
    } catch (error) {
      if (controller.signal.aborted || this.destroyed) return;
      console.error('[live-webcams] region load failed', error);
      if (!silent) {
        this.cameras = [];
        this.setStatus('ارتباط با سرویس وب‌کم برقرار نشد. اتصال اینترنت یا سیاست دسترسی شبکه را بررسی کنید.', 'error');
        this.render();
      }
    } finally {
      if (this.abortController === controller) this.abortController = null;
      if (!silent) this.setBusy(false);
    }
  }

  private async searchCity(): Promise<void> {
    const query = normalizeCityQuery(this.searchInput?.value ?? '');
    if (query.length < 2) {
      this.setStatus('نام شهر را به فارسی یا انگلیسی وارد کنید.', 'error');
      this.searchInput?.focus();
      return;
    }

    if (this.sourceMode === 'youtube') {
      this.abortController?.abort();
      this.abortController = null;
      this.searchMode = true;
      this.currentLocation = null;
      this.currentContextLabel = query;
      this.cameras = this.searchYoutube(query);
      this.selectedCameraId = this.cameras[0]?.id ?? null;
      this.updateRegionButtons();
      const embedded = this.cameras.filter(camera => camera.youtubeVideoId).length;
      this.setStatus(
        embedded > 0
          ? `${embedded} پخش منتخب YouTube برای «${query}» پیدا شد.`
          : `پخش از پیش ثبت‌شده‌ای برای «${query}» نداریم؛ لینک جستجوی مستقیم YouTube نمایش داده شد.`,
        embedded > 0 ? 'warning' : 'idle',
      );
      this.render();
      return;
    }

    this.abortController?.abort();
    const controller = new AbortController();
    this.abortController = controller;
    this.setBusy(true);
    this.setStatus(`در حال یافتن موقعیت «${query}» و وب‌کم‌های اطراف آن…`, 'loading');
    this.renderLoading('در حال جستجوی وب‌کم‌های نزدیک شهر…');

    try {
      const location = await this.geocodeCity(query, controller.signal);
      if (!location) {
        if (controller.signal.aborted) return;
        this.searchMode = true;
        this.currentLocation = null;
        this.currentContextLabel = query;
        this.cameras = [];
        this.updateRegionButtons();
        this.setStatus('شهر پیدا نشد. املای فارسی یا انگلیسی را بررسی کنید.', 'error');
        this.render();
        return;
      }

      let cameras = await this.fetchCamerasNear(
        location.latitude,
        location.longitude,
        SEARCH_PRIMARY_RADIUS_KM,
        SEARCH_RESULT_LIMIT,
        controller.signal,
      );

      if (cameras.length === 0) {
        cameras = await this.fetchCamerasNear(
          location.latitude,
          location.longitude,
          SEARCH_FALLBACK_RADIUS_KM,
          SEARCH_RESULT_LIMIT,
          controller.signal,
        );
      }

      if (controller.signal.aborted || this.destroyed) return;

      this.searchMode = true;
      this.currentLocation = location;
      this.currentContextLabel = [location.name, location.country].filter(Boolean).join(' - ');
      this.cameras = cameras;
      this.selectedCameraId = cameras[0]?.id ?? null;
      this.updateRegionButtons();

      this.setStatus(
        cameras.length
          ? `${cameras.length} وب‌کم نزدیک ${this.currentContextLabel} پیدا شد • نتیجه‌ها مستقیم از YouTube دریافت نمی‌شوند.`
          : `در شعاع ${SEARCH_FALLBACK_RADIUS_KM} کیلومتری ${this.currentContextLabel} وب‌کم غیر یوتیوب قابل‌نمایشی پیدا نشد.`,
        cameras.length ? 'success' : 'warning',
      );
      this.render();
    } catch (error) {
      if (controller.signal.aborted || this.destroyed) return;
      console.error('[live-webcams] city search failed', error);
      this.searchMode = true;
      this.currentLocation = null;
      this.currentContextLabel = query;
      this.cameras = [];
      this.updateRegionButtons();
      this.setStatus('جستجو انجام نشد. دسترسی به Open-Meteo یا OpenEye برقرار نیست.', 'error');
      this.render();
    } finally {
      if (this.abortController === controller) this.abortController = null;
      this.setBusy(false);
    }
  }

  private clearSearch(): void {
    this.abortController?.abort();
    this.abortController = null;
    this.searchMode = false;
    this.currentLocation = null;
    if (this.searchInput) this.searchInput.value = '';
    this.setStatus(
      this.sourceMode === 'youtube'
        ? 'حالت YouTube فعال است • جستجوی شهر در فهرست منتخب و لینک جستجوی مستقیم'
        : 'حالت عمومی فعال است • جستجو به فارسی و انگلیسی • منبع OpenEye',
      this.sourceMode === 'youtube' ? 'warning' : 'idle',
    );
    void this.loadRegion(this.regionFilter);
  }

  private async refreshCurrentData(): Promise<void> {
    if (this.destroyed || this.loading || document.hidden) return;
    if (this.sourceMode === 'youtube') return;

    if (!this.searchMode) {
      await this.loadRegion(this.regionFilter, true);
      return;
    }

    if (!this.currentLocation) return;

    const controller = new AbortController();
    try {
      let cameras = await this.fetchCamerasNear(
        this.currentLocation.latitude,
        this.currentLocation.longitude,
        SEARCH_PRIMARY_RADIUS_KM,
        SEARCH_RESULT_LIMIT,
        controller.signal,
      );
      if (cameras.length === 0) {
        cameras = await this.fetchCamerasNear(
          this.currentLocation.latitude,
          this.currentLocation.longitude,
          SEARCH_FALLBACK_RADIUS_KM,
          SEARCH_RESULT_LIMIT,
          controller.signal,
        );
      }
      if (this.destroyed) return;
      this.cameras = cameras;
      if (!this.selectedCameraId || !cameras.some(camera => camera.id === this.selectedCameraId)) {
        this.selectedCameraId = cameras[0]?.id ?? null;
      }
      this.render();
    } catch {
      // Silent refresh failure must not replace already-visible data.
    }
  }

  private renderLoading(message: string): void {
    this.content.className = 'panel-content oe-webcam-content';
    this.content.replaceChildren();
    const placeholder = document.createElement('div');
    placeholder.className = 'oe-webcam-placeholder';
    placeholder.textContent = message;
    this.content.appendChild(placeholder);
  }

  private render(): void {
    this.content.className = 'panel-content oe-webcam-content';
    this.content.replaceChildren();

    const context = document.createElement('div');
    context.className = 'oe-webcam-context';

    const title = document.createElement('div');
    title.className = 'oe-webcam-context-title';
    title.textContent = this.searchMode
      ? `نتایج جستجو: ${this.currentContextLabel}`
      : `وب‌کم‌ها: ${this.currentContextLabel}`;

    const provider = document.createElement('div');
    provider.className = 'oe-webcam-provider';
    provider.textContent = this.sourceMode === 'youtube'
      ? 'YouTube • حالت اختیاری'
      : 'OpenEye + Open-Meteo • بدون پخش YouTube';

    context.append(title, provider);
    this.content.appendChild(context);

    if (this.cameras.length === 0) {
      const empty = document.createElement('div');
      empty.className = 'oe-webcam-placeholder';
      empty.textContent = this.sourceMode === 'youtube'
        ? (this.searchMode
            ? 'برای این شهر پخش YouTube از پیش ثبت‌شده‌ای پیدا نشد.'
            : 'برای این ناحیه پخش YouTube از پیش ثبت‌شده‌ای وجود ندارد.')
        : (this.searchMode
            ? 'برای این شهر وب‌کم غیر یوتیوب قابل‌نمایشی پیدا نشد. شهر دیگری را جستجو کنید.'
            : 'در این ناحیه فعلاً وب‌کم غیر یوتیوب قابل‌نمایشی در دسترس نیست.');
      this.content.appendChild(empty);
      return;
    }

    if (this.viewMode === 'single') {
      this.renderSingle();
    } else {
      this.renderGrid();
    }
  }

  private renderGrid(): void {
    const grid = document.createElement('div');
    grid.className = 'oe-webcam-grid';
    const visible = this.searchMode ? this.cameras.slice(0, SEARCH_RESULT_LIMIT) : this.cameras.slice(0, GRID_LIMIT);
    for (const camera of visible) grid.appendChild(this.createCameraCard(camera));
    this.content.appendChild(grid);
  }

  private renderSingle(): void {
    const selected = this.cameras.find(camera => camera.id === this.selectedCameraId) ?? this.cameras[0];
    if (!selected) return;

    const root = document.createElement('div');
    root.className = 'oe-webcam-single';
    root.appendChild(this.createCameraCard(selected));

    if (this.cameras.length > 1) {
      const switcher = document.createElement('div');
      switcher.className = 'oe-webcam-switcher';
      for (const camera of this.cameras) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `oe-webcam-switch-btn${camera.id === selected.id ? ' active' : ''}`;
        button.textContent = camera.title;
        button.addEventListener('click', () => {
          this.selectedCameraId = camera.id;
          this.render();
        });
        switcher.appendChild(button);
      }
      root.appendChild(switcher);
    }

    this.content.appendChild(root);
  }

  private createCameraCard(camera: CameraResult): HTMLElement {
    const card = document.createElement('article');
    card.className = 'oe-webcam-card';

    const imageWrap = document.createElement('div');
    imageWrap.className = 'oe-webcam-image-wrap';

    const freshness = document.createElement('div');
    const age = camera.lastFrameAgeSeconds;
    const fresh = camera.live && (age == null || age <= Math.max(180, (camera.frameIntervalSeconds ?? 30) * 4));
    const stale = age != null && age > 900;
    freshness.className = `oe-webcam-freshness${fresh ? '' : stale ? ' stale' : ' unknown'}`;

    const dot = document.createElement('span');
    dot.className = 'oe-webcam-dot';
    const freshnessText = document.createElement('span');
    freshnessText.textContent = camera.youtubeVideoId
      ? 'YouTube'
      : fresh
        ? 'تصویر تازه'
        : age != null
          ? `آخرین فریم: ${formatFrameAge(age)}`
          : 'وضعیت نامشخص';
    freshness.append(dot, freshnessText);
    imageWrap.appendChild(freshness);

    if (camera.youtubeVideoId) {
      const iframe = document.createElement('iframe');
      iframe.className = 'oe-webcam-youtube-frame';
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(camera.youtubeVideoId)}?autoplay=0&mute=1&controls=1&playsinline=1&rel=0`;
      iframe.title = `${camera.title} - YouTube live`;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allowFullscreen = true;
      iframe.setAttribute('loading', 'lazy');
      imageWrap.appendChild(iframe);
    } else if (camera.previewUrl) {
      const image = document.createElement('img');
      image.className = 'oe-webcam-image';
      image.src = camera.previewUrl;
      image.alt = camera.title;
      image.loading = 'lazy';
      image.referrerPolicy = 'strict-origin-when-cross-origin';
      image.addEventListener('error', () => {
        if (image.src !== OPENEYE_OFFLINE_IMAGE) image.src = OPENEYE_OFFLINE_IMAGE;
      });
      imageWrap.appendChild(image);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'oe-webcam-image-placeholder';
      placeholder.textContent = 'این دوربین فقط از صفحه منبع قابل مشاهده است و تصویر مستقیمی برای جاسازی ندارد.';
      imageWrap.appendChild(placeholder);
    }

    const body = document.createElement('div');
    body.className = 'oe-webcam-card-body';

    const title = document.createElement('div');
    title.className = 'oe-webcam-card-title';
    title.textContent = camera.title;

    const meta = document.createElement('div');
    meta.className = 'oe-webcam-card-meta';
    const metaParts = [camera.category];
    const distance = formatDistance(camera.distanceKm);
    if (distance) metaParts.push(`فاصله ${distance}`);
    const ageText = formatFrameAge(camera.lastFrameAgeSeconds);
    if (ageText) metaParts.push(ageText);
    meta.textContent = metaParts.join(' • ');

    const footer = document.createElement('div');
    footer.className = 'oe-webcam-card-footer';

    const source = document.createElement('div');
    source.className = 'oe-webcam-source';
    source.textContent = camera.sourceName ? `منبع: ${camera.sourceName}` : 'فهرست OpenEye';

    footer.appendChild(source);

    if (camera.sourceUrl) {
      const openButton = document.createElement('button');
      openButton.type = 'button';
      openButton.className = 'oe-webcam-open';
      openButton.textContent = this.sourceMode === 'youtube' ? 'باز کردن در YouTube' : 'مشاهده منبع';
      openButton.addEventListener('click', event => {
        event.stopPropagation();
        window.open(camera.sourceUrl!, '_blank', 'noopener,noreferrer');
      });
      footer.appendChild(openButton);
    }

    body.append(title, meta, footer);
    card.append(imageWrap, body);
    return card;
  }

  public refresh(): void {
    void this.refreshCurrentData();
  }

  public destroy(): void {
    this.destroyed = true;
    this.abortController?.abort();
    this.abortController = null;
    if (this.refreshTimer != null) {
      window.clearInterval(this.refreshTimer);
      this.refreshTimer = null;
    }
    if (this.isFullscreen) {
      this.element.classList.remove('oe-webcam-fullscreen');
      document.body.classList.remove('oe-webcam-fullscreen-active');
      this.isFullscreen = false;
    }
    this.searchBar?.remove();
    this.controlsBar?.remove();
    super.destroy();
  }
}
